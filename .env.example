# Copy to .env and fill in. Never commit .env.
# Inside compose, DATABASE_URL is overridden to point at the `db` service.

# --- Branding (defaults live in app/core/config.py; uncomment to override) ---
# APP_NAME=
# APP_VENDOR_NAME=
# Renaming APP_NAME does NOT change the token issuer or the refresh-cookie name, so existing sessions
# survive. They default to the original values; set them only to match an older deployment that was
# started with a custom APP_NAME (issuer = lowercase hyphenated name, cookie = "<issuer>_refresh").
# JWT_ISSUER=
# REFRESH_COOKIE_NAME=

# --- Runtime ---
APP_ENV=dev                       # dev | test | prod
API_BASE_URL=http://localhost:8000
# Peers trusted to set X-Forwarded-For / -Proto (comma-separated IPs or CIDRs, or * when only the proxy can
# reach the API). Per-IP rate limits use the forwarded client address, so set this to your reverse proxy's
# address; with the default only a proxy on the same host is trusted and others' headers are ignored.
FORWARDED_ALLOW_IPS=127.0.0.1
# Frontend URL written into every invite link. Change this one line when moving from a tunnel to a domain.
APP_BASE_URL=http://localhost:3000

# --- Database ---
POSTGRES_PASSWORD=postgres        # used by compose for the db service
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/hr_assessment
# Login used ONLY by `alembic upgrade head` (entrypoint and migrations/env.py): it must be allowed to create
# roles and extensions (superuser or owner with CREATEROLE). Leave empty to migrate with DATABASE_URL.
# With it set, DATABASE_URL can be a least-privilege login (a member of app_rw, no DDL).
DATABASE_URL_MIGRATIONS=
# Separate read-only role for the reports engine
DATABASE_URL_REPORTS_RO=
DATABASE_URL_MAINTENANCE=

# --- Tokens ---
# PEM keys (RS256 or EdDSA). Multi-line values: use quoted "\n"-escaped strings.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KID=k1
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=7

# --- Encryption ---
# Comma-separated "<key_id>:<base64 of 32 random bytes>"; first is the active key.
FIELD_ENCRYPTION_KEYS=
# HMAC pepper for invite/refresh token hashes and candidate email blind indexes
TOKEN_PEPPER=

# --- Break-glass super admin, seeded on first run ---
DEFAULT_SA_EMAIL=
DEFAULT_SA_NAME=
DEFAULT_SA_PASSWORD=

# --- Object storage ---
STORAGE_DRIVER=local              # local | s3
STORAGE_LOCAL_PATH=/app/storage_data
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=

# --- Sign-in / browser integration ---
GOOGLE_CLIENT_ID=
CORS_ORIGINS=http://localhost:3000   # comma-separated
COOKIE_DOMAIN=
# Secure flag of the refresh and exam-binding cookies. Unset (leave commented) = true when APP_ENV=prod, false otherwise.
# COOKIE_SECURE=true
# Swagger UI, ReDoc and /openapi.json. Unset = on in dev/test, off when APP_ENV=prod (use `export-openapi`).
# ENABLE_DOCS=true

# --- AI provider controls ---
AI_CLI_ALLOWLIST=claude           # comma-separated
AI_CLI_TIMEOUT_SEC=120
AI_REQUEST_TIMEOUT_SEC=60

# --- Input limits ---
MAX_UPLOAD_MB=5
MAX_SNAPSHOT_KB=300
MAX_JD_CHARS=8000

# --- Rate limits (spec 4.7) ---
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_EXAM_LINK=20/minute
RATE_LIMIT_EXAM_EVENTS=120/minute
RATE_LIMIT_AI_GENERATE=5/minute
RATE_LIMIT_REPORT_INTERPRET=10/minute
RATE_LIMIT_INVITE_EMAIL=60/hour
RATE_LIMIT_SNAPSHOT_INTERVAL_SEC=20
RATE_LIMIT_SNAPSHOT_MAX_PER_ATTEMPT=300

# --- Logging / demo ---
LOG_LEVEL=INFO
DEMO_MODE=false

# --- Build-time (compose build arg): install the Claude CLI into the image ---
INSTALL_CLAUDE_CLI=false

# Runtime DB roles applied with SET LOCAL ROLE (empty disables)
DB_APP_ROLE=app_rw
DB_REPORTS_ROLE=reports_ro
